from flask import Flask, request, jsonify
import pickle

app = Flask(__name__)

# Load model and vectorizer safely
def load_pickle_file(path):
    try:
        with open(path, "rb") as f:
            return pickle.load(f)
    except Exception as e:
        print(f"Error loading {path}: {e}")
        return None

model = load_pickle_file("model.pkl")
vectorizer = load_pickle_file("vectorizer.pkl")


# Response system
RESPONSES = {
    "happy": {
        "music": ["Happy - Pharrell", "Good Life - OneRepublic"],
        "advice": "Keep spreading positivity!"
    },
    "sad": {
        "music": ["Fix You - Coldplay", "Let Her Go - Passenger"],
        "advice": "Take it slow. Better days will come."
    },
    "angry": {
        "music": ["Believer - Imagine Dragons"],
        "advice": "Pause and breathe. Control your energy."
    }
}

DEFAULT_RESPONSE = {
    "music": ["Blinding Lights - The Weeknd"],
    "advice": "Stay balanced."
}


def get_response(emotion):
    return RESPONSES.get(emotion, DEFAULT_RESPONSE)


@app.route("/analyze", methods=["POST"])
def analyze():
    if not model or not vectorizer:
        return jsonify({"error": "Model or vectorizer not loaded"}), 500

    data = request.get_json()

    if not data or "text" not in data:
        return jsonify({"error": "Invalid input. Provide 'text' field."}), 400

    text = data["text"]

    try:
        # Transform and predict
        vector = vectorizer.transform([text])
        emotion = model.predict(vector)[0]

        response = get_response(emotion)

        return jsonify({
            "success": True,
            "emotion": emotion,
            "music": response["music"],
            "advice": response["advice"]
        })

    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/")
def home():
    return jsonify({"message": "Emotion Detection API is running 🚀"})


if __name__ == "__main__":
    app.run(debug=True)
